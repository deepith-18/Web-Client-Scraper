# ─────────────────────────────────────────────────────────────
# Demanex Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32

# SQLite (local dev) or Postgres (production)
DATABASE_URL=sqlite:///./prospectiq.db
# DATABASE_URL=postgresql://postgres:YOUR_PG_PASS@localhost:5432/demanex

# Seed user passwords — set these before first run
# If not set, random one-time passwords are generated and printed to console
ADMIN_SEED_PASSWORD=CHANGE_ME_admin_password
CALLER_SEED_PASSWORD=CHANGE_ME_caller_password

# Google APIs (optional — platform falls back to open OSM sources without these)
GOOGLE_PLACES_API_KEY=
GOOGLE_PAGESPEED_API_KEY=

