# ─────────────────────────────────────────────────────────────
# Demanex — Docker Compose Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=demanex

# Backend
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
ADMIN_SEED_PASSWORD=CHANGE_ME_admin_password
CALLER_SEED_PASSWORD=CHANGE_ME_caller_password
REQUEST_TIMEOUT_SECONDS=15

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Firebase (NEXT_PUBLIC_ vars are intentionally public — safe to commit separately)
